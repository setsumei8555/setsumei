
<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport"
        content="width=device-width, initial-scale=1, viewport-fit=cover">

  <title>サルプレップ｜1日法の説明動画</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      padding: 20px 16px;
      font-family: -apple-system, BlinkMacSystemFont,
                   "Helvetica Neue", sans-serif;
      color: #263238;
      background: #ffffff;
    }

    .salprep-video {
      width: 100%;
      max-width: 960px;
      margin: 0 auto;
    }

    .salprep-video p {
      margin: 0 0 8px;
      font-size: 15px;
      line-height: 1.6;
    }

    .salprep-video h1 {
      margin: 8px 0;
      font-size: 28px;
    }

    .salprep-video h2 {
      margin: 0 0 24px;
      font-size: 20px;
      font-weight: 600;
    }

    .salprep-video-button {
      display: flex;
      justify-content: center;
      align-items: center;
      width: 100%;
      min-height: 58px;
      padding: 16px;
      border: 0;
      border-radius: 12px;
      background: #176B87;
      color: #ffffff;
      font-size: 18px;
      font-weight: 700;
      cursor: pointer;
      -webkit-appearance: none;
      appearance: none;
      touch-action: manipulation;
    }

    .salprep-video-button:active {
      background: #12566d;
    }

    .salprep-player {
      width: 100%;
      max-width: 960px;
      margin: 20px auto 0;
    }

    .salprep-player[hidden],
    .salprep-video-button[hidden] {
      display: none !important;
    }

    /* 動画は常に16:9 */
    .salprep-player-frame {
      position: relative;
      width: 100%;
      aspect-ratio: 16 / 9;
      overflow: hidden;
      border-radius: 12px;
      background: #eaf0f3;
    }

    .salprep-player-frame iframe {
      position: absolute;
      inset: 0;
      display: block;
      width: 100%;
      height: 100%;
      border: 0;
    }

    .salprep-close-button {
      display: block;
      min-height: 44px;
      margin: 16px auto 0;
      padding: 10px 24px;
      border: 1px solid #176B87;
      border-radius: 8px;
      background: #ffffff;
      color: #176B87;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
      -webkit-appearance: none;
      appearance: none;
    }

    button:focus-visible {
      outline: 3px solid #F0A830;
      outline-offset: 3px;
    }

    @media (max-width: 600px) {
      body {
        padding: 16px 12px;
      }

      .salprep-video h1 {
        font-size: 24px;
      }

      .salprep-video h2 {
        font-size: 18px;
      }

      .salprep-video-button {
        font-size: 17px;
      }
    }
  </style>
</head>

<body>
  <main class="salprep-video">
    <p>大腸内視鏡検査 前処置のご案内</p>
    <h1>サルプレップ</h1>
    <h2>1日法の説明動画</h2>

    <button
      type="button"
      id="salprepPlay"
      class="salprep-video-button"
      aria-expanded="false"
      aria-controls="salprepPlayer">
      ▶ 動画を見る
    </button>

    <section
      id="salprepPlayer"
      class="salprep-player"
      aria-label="説明動画"
      hidden>

      <div class="salprep-player-frame">
        <iframe
          id="salprepIframe"
          src="https://drive.google.com/file/d/1k62bBcJn9yEHMSwqtgKBALa3OZ56-AGJ/preview"
          title="サルプレップ 1日法の説明動画"
          allow="autoplay; fullscreen"
          allowfullscreen>
        </iframe>
      </div>

      <button
        type="button"
        id="salprepClose"
        class="salprep-close-button">
        動画を閉じる
      </button>
    </section>
  </main>

  <script>
    (() => {
      const playButton = document.getElementById("salprepPlay");
      const player = document.getElementById("salprepPlayer");
      const closeButton = document.getElementById("salprepClose");
      const iframe = document.getElementById("salprepIframe");

      const videoUrl =
        "https://drive.google.com/file/d/1k62bBcJn9yEHMSwqtgKBALa3OZ56-AGJ/preview";

      playButton.addEventListener("click", () => {
        player.hidden = false;
        playButton.hidden = true;
        playButton.setAttribute("aria-expanded", "true");

        player.scrollIntoView({
          behavior: "smooth",
          block: "nearest"
        });
      });

      closeButton.addEventListener("click", () => {
        // iframeを再読み込みして動画を停止
        iframe.src = "about:blank";
        player.hidden = true;
        playButton.hidden = false;
        playButton.setAttribute("aria-expanded", "false");

        // 次回表示時に動画を再度読み込む
        iframe.src = videoUrl;

        playButton.focus();
      });
    })();
  </script>
</body>
</html>
